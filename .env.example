# 이 파일을 복사해서 .env 를 만들고 값을 채워요. .env 는 깃에 올리지 않아요.
# SECRET_KEY: 세션 · flash 를 잠그는 열쇠. 길고 무작위인 글자 (Render에선 Environment Variables에 따로 넣기)
SECRET_KEY=

# 물어보기(/ask) — 제미나이 키 (https://aistudio.google.com/apikey). Render에선 Environment Variables에 따로 넣기
GOOGLE_API_KEY=
# 아래는 안 써도 돼요 (기본값이 있어요)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-3.1-flash-lite
# OPENAI_EMBED_MODEL=gemini-embedding-001
# OLLAMA_MODEL=qwen2.5:14b
